# Область ОбработчикиСобытийФормы

&НаСервере
Процедура ГП_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	// Добавляем реквизиты формы
	МассивРеквизитов = Новый Массив;
	
	НовыйРеквизит = Новый РеквизитФормы("ВыбранныеТипыСтрокой", Новый ОписаниеТипов("Строка"));
	МассивРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы("СписокТиповДокументов", Новый ОписаниеТипов("СписокЗначений"));
	МассивРеквизитов.Добавить(НовыйРеквизит);
	
	ИзменитьРеквизиты(МассивРеквизитов);
	
	// Устанавливаем тип значений списка
	ЭтотОбъект.СписокТиповДокументов.ТипЗначения = Новый ОписаниеТипов("Строка");
	
	// Добавляем поле для списка типов документов
	ПолеСпискаТипов = Элементы.Добавить("СписокТиповДокументов", Тип("ПолеФормы"));
	ПолеСпискаТипов.Вид = ВидПоляФормы.ПолеВвода;
	ПолеСпискаТипов.ПутьКДанным = "СписокТиповДокументов";
	ПолеСпискаТипов.Заголовок = НСтр("ru = 'Типы документов'");
	ПолеСпискаТипов.КнопкаВыбора = Истина;
	ПолеСпискаТипов.УстановитьДействие("ПриИзменении", "ГП_СписокТиповДокументовПриИзменении");
	
	// Добавляем команду "Выполнить с фильтром"
	КомандаФильтр = Команды.Добавить("ВыполнитьСФильтром");
	КомандаФильтр.Заголовок = НСтр("ru = 'Выполнить с фильтром'");
	КомандаФильтр.Действие = "ГП_ВыполнитьСФильтром";
	
	КнопкаФильтр = Элементы.Добавить("ВыполнитьСФильтром", Тип("КнопкаФормы"));
	КнопкаФильтр.ИмяКоманды = "ВыполнитьСФильтром";
	
	// Добавляем команду "Настройка параметров"
	КомандаНастройка = Команды.Добавить("НастройкаПараметров");
	КомандаНастройка.Заголовок = НСтр("ru = 'Настройка параметров...'");
	КомандаНастройка.Действие = "ГП_НастройкаПараметров";
	
	КнопкаНастройка = Элементы.Добавить("НастройкаПараметров", Тип("КнопкаФормы"));
	КнопкаНастройка.ИмяКоманды = "НастройкаПараметров";
	
	// Заполняем список проводимых документов
	ЗаполнитьСписокПроводимыхДокументов();
	
КонецПроцедуры

&НаСервере
Процедура ГП_ПриЗагрузкеДанныхИзНастроекНаСервереПосле(Настройки)
	
	НастройкаТипов = Настройки.Получить("ВыбранныеТипыСтрокой");
	
	Если НастройкаТипов <> Неопределено Тогда
		ЭтотОбъект.ВыбранныеТипыСтрокой = НастройкаТипов;
		// Восстанавливаем отметки в списке документов
		ЗаполнитьСписокПроводимыхДокументов();
	КонецЕсли;

КонецПроцедуры             

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ГП_СписокТиповДокументовПриИзменении(Элемент)
	
	ГП_СписокТиповДокументовПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ГП_ВыполнитьСФильтром(Команда)
	
	ГП_ВыполнитьНаСервереСФильтром();
	
КонецПроцедуры

&НаКлиенте
Процедура ГП_НастройкаПараметров(Команда)
	
	ОткрытьФорму("Обработка.ГрупповоеПерепроведениеДокументов.Форма.НастройкаПараметров");
	
КонецПроцедуры

&НаСервере
Процедура ГП_СписокТиповДокументовПриИзмененииНаСервере()
	
	ВыбранныеТипыДляОтбора = Новый Массив;
	Для Каждого Элемент Из ЭтотОбъект.СписокТиповДокументов Цикл
		Если Элемент.Пометка Тогда
			ВыбранныеТипыДляОтбора.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ЭтотОбъект.ВыбранныеТипыСтрокой = СтрСоединить(ВыбранныеТипыДляОтбора, ";");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПроводимыхДокументов()
	
	ЭтотОбъект.СписокТиповДокументов.Очистить();
	
	Для Каждого ОбъектМетаданных Из Метаданные.Документы Цикл
		Если ОбъектМетаданных.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
			ЭтотОбъект.СписокТиповДокументов.Добавить(ОбъектМетаданных.Имя, ОбъектМетаданных.Представление(), Ложь);
		КонецЕсли;
	КонецЦикла;
	
	// Заполняем список выбора у элемента формы
	ЭлементСписка = Элементы.Найти("СписокТиповДокументов");
	Если ЭлементСписка <> Неопределено Тогда
		ЭлементСписка.СписокВыбора.Очистить();
		Для Каждого Элемент Из ЭтотОбъект.СписокТиповДокументов Цикл
			ЭлементСписка.СписокВыбора.Добавить(Элемент.Значение, Элемент.Представление);
		КонецЦикла;
	КонецЕсли;
	
	// Восстанавливаем отметки из сохраненной строки
	Если ЗначениеЗаполнено(ЭтотОбъект.ВыбранныеТипыСтрокой) Тогда
		МассивВыбранных = СтрРазделить(ЭтотОбъект.ВыбранныеТипыСтрокой, ";");
		Для Каждого Элемент Из ЭтотОбъект.СписокТиповДокументов Цикл
			Если МассивВыбранных.Найти(Элемент.Значение) <> Неопределено Тогда
				Элемент.Пометка = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ГП_ВыполнитьНаСервереСФильтром()

	Если ТолькоВыбранныеОрганизации = 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Организация
		|ИЗ
		|	Справочник.Организации КАК Организации";
		Выборка = Запрос.Выполнить().Выбрать();
		ВыбранныеОрганизации = Новый Массив;
		Пока Выборка.Следующий() Цикл
			ВыбранныеОрганизации.Добавить(Выборка.Организация);
		КонецЦикла;
	Иначе
		ВыбранныеОрганизации = Новый Массив;
		Для Каждого ЭлементСпискаОрганизаций Из ТаблицаОрганизаций Цикл
			Если ЗначениеЗаполнено(ЭлементСпискаОрганизаций.Организация) Тогда
				ВыбранныеОрганизации.Добавить(ЭлементСпискаОрганизаций.Организация);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли; 

	// Возможно, что фоновое задание было запущено раньше, 
	// пользователь дал команду его отменить, однако задание не отменено.
	// В таком случае не следует запускать задание повторно - следует дождаться его выполнения.
	// Мы можем отследить ситуацию, только если все это происходит в одной форме.
	Если ОписаниеФоновогоЗадания <> Неопределено Тогда

		Если ЗаданиеЕщеВыполняется(ОписаниеФоновогоЗадания.ИдентификаторЗадания) Тогда
			Возврат Неопределено; // надо ждать
		КонецЕсли;
		ОписаниеФоновогоЗадания = Неопределено;

	КонецЕсли;

	СтруктураПараметров = Новый Структура("Организация, ДатаНачала, ДатаОкончания, ЗаписыватьОшибкиВЖурналРегистрации, ОстанавливатьсяПоОшибке, 
	|СообщатьПрогрессВыполнения, АдресХранилищаСОшибками, ДанныеЗаблокированы, ТолькоВыбранныеОрганизации, ВыбранныеТипы",
	ВыбранныеОрганизации,
	?(ЗначениеЗаполнено(Объект.ДатаНачала), Объект.ДатаНачала, Неопределено),
	?(ЗначениеЗаполнено(Объект.ДатаОкончания), Объект.ДатаОкончания, Неопределено),
	Истина,
	Объект.ОстанавливатьсяПоОшибке,
	Истина,
	"",
	Истина, // фильтр по метаданным
 	?(ТолькоВыбранныеОрганизации = 0, Ложь, Истина),
	ЭтотОбъект.ВыбранныеТипыСтрокой);

	// Временное хранилище для отчета об ошибках необходимо создавать
	// в том же сеансе работы с пользователем, из которого требуется обращение к ним, 
	// т.к. временное хранилище очищается при завершении сеанса фонового задания.
	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.АдресХранилищаСОшибками) Тогда
		СтруктураПараметров.Вставить("АдресХранилищаСОшибками", ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор));
	КонецЕсли;

	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);

	КлючЗадания = "";	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Групповое перепроведение документов'");
	ПараметрыВыполнения.КлючФоновогоЗадания = КлючЗадания;
	// Если на файловой базе уже запущено любое другое фоновое задание, то новое встанет в очередь, а не будет запущено в основном потоке.
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;

	ОписаниеФоновогоЗадания = ДлительныеОперации.ВыполнитьПроцедуру(
	ПараметрыВыполнения,
	"Обработки.ГрупповоеПерепроведениеДокументов.ПерепроведениеДокументов",
	СтруктураПараметров,
	АдресХранилища);

	ИдентификаторЗадания = ОписаниеФоновогоЗадания.ИдентификаторЗадания;

	Результат = ОбщегоНазначения.СкопироватьРекурсивно(ОписаниеФоновогоЗадания);

	Результат.Вставить("ВыбранныеОрганизации",        ВыбранныеОрганизации);
	Результат.Вставить("ДатаНачалаПерепроведения",    Объект.ДатаНачала);
	Результат.Вставить("ДатаОкончанияПерепроведения", Объект.ДатаОкончания);

	Возврат Результат;

КонецФункции

#КонецОбласти

