#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Загружаем все параметры из регистра
	ПараметрыИзРегистра = РегистрыСведений.ГП_ПараметрыРегламентныхЗаданий.ПолучитьВсеПараметры();
	
	// Заполняем реквизиты формы
	ВыбранныеТипыСтрокой = ПараметрыИзРегистра.ВыбранныеТипыСтрокой;
	ДатаНачалаПроведения = ПараметрыИзРегистра.ДатаНачалаПроведения;
	КоличествоМесяцевДляПерепроведения = ПараметрыИзРегистра.КоличествоМесяцевДляПерепроведения;
	
	// Устанавливаем тип значения для списков
	СписокТиповДокументов.ТипЗначения = Новый ОписаниеТипов("Строка");
	Организации.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Организации");
	
	// Десериализуем массив организаций
	СтрокаОрганизаций = ПараметрыИзРегистра.ВыбранныеОрганизации;
	Если ЗначениеЗаполнено(СтрокаОрганизаций) Тогда
		МассивОрганизаций = СериализаторXDTO.ПрочитатьXDTO(СтрокаОрганизаций);
		Если ТипЗнч(МассивОрганизаций) = Тип("Массив") Тогда
			Организации.ЗагрузитьЗначения(МассивОрганизаций);
		КонецЕсли;
	КонецЕсли;
	
	// Заполняем список типов документов
	ЗаполнитьСписокПроводимыхДокументов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
	
	СохранитьПараметрыНаСервере();
	Оповестить("Запись_ГП_ПараметрыРегламентныхЗаданий");
	ПоказатьОповещениеПользователя("Параметры сохранены");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокТиповДокументовПриИзменении(Элемент)
	
	СписокТиповДокументовПриИзмененииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписокПроводимыхДокументов()
	
	СписокТиповДокументов.Очистить();
	
	Для Каждого ОбъектМетаданных Из Метаданные.Документы Цикл
		Если ОбъектМетаданных.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
			СписокТиповДокументов.Добавить(ОбъектМетаданных.Имя, ОбъектМетаданных.Представление(), Ложь);
		КонецЕсли;
	КонецЦикла;
	
	// Восстанавливаем отметки из сохраненной строки
	Если ЗначениеЗаполнено(ВыбранныеТипыСтрокой) Тогда
		МассивВыбранных = СтрРазделить(ВыбранныеТипыСтрокой, ";");
		Для Каждого Элемент Из СписокТиповДокументов Цикл
			Если МассивВыбранных.Найти(Элемент.Значение) <> Неопределено Тогда
				Элемент.Пометка = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СписокТиповДокументовПриИзмененииНаСервере()
	
	ВыбранныеТипыДляОтбора = Новый Массив;
	Для Каждого Элемент Из СписокТиповДокументов Цикл
		Если Элемент.Пометка Тогда
			ВыбранныеТипыДляОтбора.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ВыбранныеТипыСтрокой = СтрСоединить(ВыбранныеТипыДляОтбора, ";");
	
КонецПроцедуры

&НаСервере
Процедура СохранитьПараметрыНаСервере()
	
	// Сохраняем выбранные типы документов
	ВыбранныеТипыДляОтбора = Новый Массив;
	Для Каждого Элемент Из СписокТиповДокументов Цикл
		Если Элемент.Пометка Тогда
			ВыбранныеТипыДляОтбора.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	ВыбранныеТипыСтрокой = СтрСоединить(ВыбранныеТипыДляОтбора, ";");
	
	// Сериализуем массив организаций
	МассивОрганизаций = Организации.ВыгрузитьЗначения();
	СтрокаОрганизаций = СериализаторXDTO.ЗаписатьXDTO(МассивОрганизаций);
	
	// Сохраняем все параметры через модуль менеджера
	РегистрыСведений.ГП_ПараметрыРегламентныхЗаданий.УстановитьПараметр("ВыбранныеТипыСтрокой", ВыбранныеТипыСтрокой);
	РегистрыСведений.ГП_ПараметрыРегламентныхЗаданий.УстановитьПараметр("ДатаНачалаПроведения", ДатаНачалаПроведения);
	РегистрыСведений.ГП_ПараметрыРегламентныхЗаданий.УстановитьПараметр("КоличествоМесяцевДляПерепроведения", КоличествоМесяцевДляПерепроведения);
	РегистрыСведений.ГП_ПараметрыРегламентныхЗаданий.УстановитьПараметр("ВыбранныеОрганизации", СтрокаОрганизаций);
	
КонецПроцедуры

#КонецОбласти
