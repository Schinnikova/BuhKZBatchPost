#Область ПрограммныйИнтерфейс

// Получает значение параметра из регистра сведений.
//
// Параметры:
//   Параметр - ПеречислениеСсылка.ГП_ПараметрыРегламентныхЗаданий - имя параметра
//   ЗначениеПоУмолчанию - Произвольный - значение, возвращаемое если параметр не найден
//
// Возвращаемое значение:
//   Произвольный - значение параметра
//
Функция ПолучитьПараметр(Параметр, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ГП_ПараметрыРегламентныхЗаданий.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ГП_ПараметрыРегламентныхЗаданий КАК ГП_ПараметрыРегламентныхЗаданий
	|ГДЕ
	|	ГП_ПараметрыРегламентныхЗаданий.Параметр = &Параметр";
	
	Запрос.УстановитьПараметр("Параметр", Параметр);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.Значение = Неопределено Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		Возврат Выборка.Значение.Получить();
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
КонецФункции

// Устанавливает значение параметра в регистре сведений.
//
// Параметры:
//   Параметр - ПеречислениеСсылка.ГП_ПараметрыРегламентныхЗаданий - имя параметра
//   Значение - Произвольный - значение параметра для сохранения
//   Документ - ДокументСсылка - необязательный, ссылка на документ, инициировавший изменение
//
Процедура УстановитьПараметр(Параметр, Значение, Документ = Неопределено) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.ГП_ПараметрыРегламентныхЗаданий.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Параметр = Параметр;
	МенеджерЗаписи.Прочитать();
	МенеджерЗаписи.Параметр = Параметр;
	МенеджерЗаписи.Значение = Новый ХранилищеЗначения(Значение);
	
	Если Документ <> Неопределено Тогда
		МенеджерЗаписи.Документ = Документ;
	КонецЕсли;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Получает все параметры регламентного задания.
//
// Возвращаемое значение:
//   Соответствие - ключ: ПеречислениеСсылка.ГП_ПараметрыРегламентныхЗаданий, значение: Произвольный
//
Функция ПолучитьВсеПараметры() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ГП_ПараметрыРегламентныхЗаданий.Параметр КАК Параметр,
	|	ГП_ПараметрыРегламентныхЗаданий.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ГП_ПараметрыРегламентныхЗаданий КАК ГП_ПараметрыРегламентныхЗаданий";
	
	Результат = Новый Соответствие;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Выборка.Параметр, Выборка.Значение.Получить());
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
